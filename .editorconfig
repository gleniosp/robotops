root = true

# Fallback for files without a dedicated formatter.
# Vite+ owns source formatting; dprint owns documents and configuration.
[{*.txt,*.sh,Dockerfile,LICENSE,.editorconfig,.gitignore,.gitattributes}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
